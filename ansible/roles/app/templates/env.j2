DJANGO_SETTINGS_MODULE={{ app_name }}.settings.production
DJANGO_SECRET_KEY={{ django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ domain_name }}
DJANGO_ADMIN_URL={{ django_admin_url }}
DJANGO_STATIC_ROOT={{ static_root }}
DJANGO_MEDIA_ROOT={{ media_root }}
DATABASE_URL=postgres://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}
REDIS_URL=redis://{{ redis_bind }}:{{ redis_port }}/0
SENTRY_DSN={{ vault_sentry_dsn | default('') }}
MAILGUN_API_KEY={{ mailgun_api_key }}
MAILGUN_DOMAIN={{ mailgun_domain }}
CLAUDE_API_KEY={{ claude_api_key | default('') }}
